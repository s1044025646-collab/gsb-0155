  "demo": "tsx scripts/demo.ts",
  "stop": "tsx scripts/stop.ts",
  "cli": "tsx src/cli.ts",
  "test": "node --import tsx --test tests/*.test.ts"
 },
 "license": "MIT",
 "devDependencies": {
  "@types/node": "^22.10.0",
  "tsx": "^4.19.2",
  "typescript": "^5.7.2"
 }
